{
  "name": "@jasonfutch/worktree-manager",
  "version": "1.0.0",
  "description": "Terminal app for managing git worktrees with AI assistance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wtm": "dist/index.js",
    "worktree-manager": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "worktree",
    "terminal",
    "tui",
    "cli",
    "claude",
    "ai",
    "vscode",
    "cursor"
  ],
  "author": "jasonfutch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonfutch/worktree-manager.git"
  },
  "bugs": {
    "url": "https://github.com/jasonfutch/worktree-manager/issues"
  },
  "homepage": "https://github.com/jasonfutch/worktree-manager#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "chalk": "^5.6.2",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/blessed": "^0.1.27",
    "@types/node": "^25.0.3",
    "eslint": "^9.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2"
  }
}
